@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Cảnh báo An ninh";
}

<style>
    :root {
        --accent: #3b82f6;
        --text-main: #1e293b;
        --text-muted: #64748b;
        --border: #e2e8f0;
    }

    .alert-dashboard-header {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .kpi-card {
        background: white;
        padding: 20px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        border: 1px solid var(--border);
    }

    .kpi-info p {
        margin: 0;
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-muted);
    }

    .kpi-info h3 {
        margin: 5px 0 0 0;
        font-size: 1.8rem;
        font-weight: 900;
    }

    .kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Đã nới rộng cột trái và bỏ giới hạn chiều cao để khung camera thoải mái phình to */
    .alert-layout {
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 25px;
        min-height: 800px;
    }

    .alert-list-container {
        background: white;
        border-radius: 16px;
        border: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        height: 100%;
        min-height: 600px;
    }

    .list-header {
        padding: 15px 20px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #f8fafc;
    }

        .list-header h3 {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .alert-items {
        flex: 1;
        overflow-y: auto;
        padding: 15px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .alert-card {
        display: flex;
        gap: 15px;
        padding: 15px;
        border-radius: 12px;
        border: 1px solid var(--border);
        cursor: pointer;
        transition: 0.2s;
        background: white;
    }

        .alert-card:hover {
            border-color: #cbd5e1;
            transform: translateX(5px);
        }

        .alert-card.active {
            border-color: #ef4444;
            background: #fef2f2;
        }

        .alert-card.resolved {
            opacity: 0.6;
        }

    .alert-thumb {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        object-fit: cover;
        background: #1e293b;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: bold;
    }

    .alert-title {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 5px;
        color: var(--text-main);
    }

    .alert-meta {
        display: flex;
        gap: 15px;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .alert-detail-container {
        background: white;
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 25px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .detail-header-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .detail-title-large {
        font-size: 1.5rem;
        font-weight: 900;
        margin: 0 0 5px 0;
        color: var(--text-main);
    }

    .detail-id {
        color: var(--text-muted);
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* ĐÃ NÂNG CHIỀU CAO KHUNG CAMERA LÊN 550PX CHO TOÀNH CẢNH & CHÂN THỰC */
    .detail-evidence {
        position: relative;
        background: #0f172a;
        border-radius: 16px;
        height: 550px;
        margin-bottom: 25px;
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 4px solid #1e293b;
        box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
    }

    .evidence-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    /* Đổi thành cover để tràn viền đẹp hơn */

    .ai-overlay-box {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(0,0,0,0.7);
        color: #22c55e;
        padding: 12px 18px;
        border-radius: 8px;
        font-family: monospace;
        font-size: 13px;
        border: 1px solid #22c55e;
        pointer-events: none;
        line-height: 1.5;
        text-shadow: 0 0 5px rgba(34,197,94,0.5);
        z-index: 10;
    }

    .detail-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
        background: #f8fafc;
        padding: 20px;
        border-radius: 12px;
    }

    .info-group label {
        font-size: 0.75rem;
        font-weight: 800;
        color: var(--text-muted);
        margin-bottom: 5px;
        display: block;
    }

    .info-group div {
        font-weight: 700;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-panel {
        border-top: 1px dashed var(--border);
        padding-top: 20px;
    }

    .action-title {
        font-weight: 800;
        font-size: 0.9rem;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-buttons-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .btn-action-alert {
        padding: 12px;
        border-radius: 8px;
        border: none;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-accept {
        background: #3b82f6;
        color: white;
    }

        .btn-accept:hover {
            background: #2563eb;
        }

    .btn-false {
        background: #f1f5f9;
        color: var(--text-main);
    }

        .btn-false:hover {
            background: #e2e8f0;
        }

    .btn-alert-siren {
        background: #ef4444;
        color: white;
    }

        .btn-alert-siren:hover {
            background: #dc2626;
        }

    .btn-resolve {
        background: #10b981;
        color: white;
    }

        .btn-resolve:hover {
            background: #059669;
        }
</style>

<div style="margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
        <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin-bottom: 5px;">Cảnh báo An ninh</h2>
        <p style="color: var(--text-muted); font-size: 0.95rem; font-weight: 500; margin: 0;">Trung tâm tiếp nhận sự cố Tracking AI tự động (Camera 5001).</p>
    </div>
    <div style="font-size: 13px; font-weight: 600; background: white; padding: 8px 15px; border-radius: 8px; border: 1px solid var(--border);">
        Hôm nay: <span style="color: var(--accent);">@DateTime.Now.ToString("dd/MM/yyyy")</span>
    </div>
</div>

<section class="alert-dashboard-header">
    <div class="kpi-card">
        <div class="kpi-info" style="flex: 1;"><p>SỰ CỐ CHỜ XỬ LÝ</p><h3 id="kpiPending" style="color: #ef4444;">0</h3></div>
        <div class="kpi-icon" style="background: #fef2f2; color: #ef4444;"><i data-lucide="shield-alert"></i></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-info" style="flex: 1;"><p>ĐÃ GIẢI QUYẾT</p><h3 id="kpiResolved" style="color: #10b981;">0</h3></div>
        <div class="kpi-icon" style="background: #ecfdf5; color: #10b981;"><i data-lucide="check-square"></i></div>
    </div>
</section>

<section class="alert-layout">
    <!-- CỘT TRÁI: DANH SÁCH -->
    <div class="alert-list-container">
        <div class="list-header">
            <h3><i data-lucide="list-filter" style="color: var(--accent); width: 18px;"></i> Danh sách Sự cố</h3>
            <button onclick="resetToLivestream()" title="Quay lại Livestream Camera" style="border:none; background:none; cursor:pointer; color:var(--accent);"><i data-lucide="video" style="width:18px;"></i></button>
        </div>
        <div class="alert-items" id="alertListContainer">
            <div style="text-align:center; padding: 20px; color: #94a3b8;">Đang tải dữ liệu...</div>
        </div>
    </div>

    <!-- CỘT PHẢI: CHI TIẾT SỰ CỐ / LIVESTREAM -->
    <div class="alert-detail-container">
        <div class="detail-header-top">
            <div>
                <h2 class="detail-title-large" id="detTitle">Live: Giám sát Hành lang</h2>
                <span class="detail-id" id="detId">Hệ thống Camera 5001 (YOLO Tracking)</span>
            </div>
            <span id="detBadge" style="display:none; font-size: 12px; font-weight: 800; background: #ef4444; color: white; padding: 6px 12px; border-radius: 8px; align-items: center; gap: 5px;">
                <i data-lucide="alert-triangle" style="width: 14px;"></i> KHẨN CẤP
            </span>
        </div>

        <!-- CAMERA VIEWPORT ĐÃ ĐƯỢC LÀM TO RA -->
        <div class="detail-evidence">
            <img id="detImage" src="http://localhost:5001/video_security_feed" class="evidence-img" onerror="this.src='https://placehold.co/1280x720/0f172a/38bdf8?text=VUI+LONG+BAT+PYTHON+(PORT+5001)'" />

            <div class="ai-overlay-box" id="aiOverlay">
                > MODE: LIVE_TRACKING<br />
                > YOLO_V8: ACTIVE<br />
                > STATUS: SCANNING...
            </div>
        </div>

        <div class="detail-info-grid">
            <div class="info-group">
                <label>THỜI GIAN GHI NHẬN</label>
                <div id="detTime"><i data-lucide="clock" style="width: 16px; color: var(--accent);"></i> Real-time Livestream</div>
            </div>
            <div class="info-group">
                <label>VỊ TRÍ</label>
                <div><i data-lucide="map-pin" style="width: 16px; color: var(--accent);"></i> Hành lang KTX (CAM-02)</div>
            </div>
            <div class="info-group">
                <label>TRẠNG THÁI HIỆN TẠI</label>
                <div id="detStatusUI" style="color: #10b981;"><i data-lucide="shield-check" style="width: 16px;"></i> An toàn</div>
            </div>
        </div>

        <!-- BẢNG ĐIỀU KHIỂN (Ẩn khi xem Live) -->
        <div class="action-panel" id="actionPanel" style="display:none;">
            <div class="action-title"><i data-lucide="shield" style="width: 18px; color: var(--accent);"></i> BẢNG XỬ LÝ SỰ CỐ</div>
            <div class="action-buttons-grid">
                <button class="btn-action-alert btn-accept" onclick="updateStatus()">
                    <i data-lucide="check-circle" style="width: 18px;"></i> Xác nhận ĐÃ GIẢI QUYẾT AN TOÀN
                </button>
                <button class="btn-action-alert btn-alert-siren" onclick="alert('ĐÃ GỌI BẢO VỆ!')">
                    <i data-lucide="siren" style="width: 18px;"></i> BÁO ĐỘNG KHẨN
                </button>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        if (typeof lucide !== 'undefined') { lucide.createIcons(); }

        let currentAlertId = null;

        function loadAlerts() {
            fetch('/Admin/CanhBao/LayDanhSachSuCo')
                .then(res => res.json())
                .then(data => {
                    let html = '';
                    let pendingCount = 0, resolvedCount = 0;

                    if (!data || data.length === 0) {
                        html = '<div style="text-align:center; color:#94a3b8; margin-top:20px;">Hệ thống an toàn. Chưa có sự cố.</div>';
                    } else {
                        data.forEach(item => {
                            if (!item.trangThai) { pendingCount++; } else { resolvedCount++; }

                            let cardClass = item.trangThai ? "alert-card resolved" : "alert-card unread";
                            let activeClass = (currentAlertId === item.id) ? "active" : "";
                            let badgeHtml = item.trangThai
                                ? `<span style="font-size: 10px; font-weight: 700; background: #dcfce7; color: #16a34a; padding: 2px 6px; border-radius: 4px;">ĐÃ XỬ LÝ</span>`
                                : `<span style="font-size: 10px; font-weight: 700; background: #fee2e2; color: #dc2626; padding: 2px 6px; border-radius: 4px;">KHẨN CẤP</span>`;

                            // Truyền dữ liệu vào thẻ
                            html += `
                                <div class="${cardClass} ${activeClass}" onclick="selectAlert(${item.id}, '${item.noiDung}', '${item.thoiGian}', '${item.gio}', '${item.hinhAnh}', ${item.trangThai})">
                                    <img src="${item.hinhAnh}" class="alert-thumb" onerror="this.src='/images/no-image.png'" />
                                    <div class="alert-content" style="flex:1;">
                                        <div class="alert-title">${item.noiDung}</div>
                                        <div class="alert-meta">
                                            <span><i data-lucide="clock" style="width: 12px"></i> ${item.gio}</span>
                                        </div>
                                        ${badgeHtml}
                                    </div>
                                </div>
                            `;
                        });
                    }

                    document.getElementById('alertListContainer').innerHTML = html;
                    document.getElementById('kpiPending').innerText = pendingCount;
                    document.getElementById('kpiResolved').innerText = resolvedCount;
                    lucide.createIcons();
                });
        }

        function resetToLivestream() {
            currentAlertId = null;
            document.querySelectorAll('.alert-card').forEach(c => c.classList.remove('active'));

            document.getElementById('detTitle').innerText = "Live: Giám sát Hành lang";
            document.getElementById('detId').innerText = "Hệ thống Camera 5001 (YOLO Tracking)";
            document.getElementById('detTime').innerHTML = `<i data-lucide="clock" style="width: 16px; color: var(--accent);"></i> Real-time Livestream`;

            // Lách cache để ép load lại luồng camera
            let timestamp = new Date().getTime();
            document.getElementById('detImage').src = "http://localhost:5001/video_security_feed?t=" + timestamp;
            document.getElementById('detImage').style.objectFit = "cover";

            document.getElementById('detBadge').style.display = "none";
            document.getElementById('actionPanel').style.display = "none";

            document.getElementById('aiOverlay').innerHTML = `> MODE: LIVE_TRACKING<br/>> YOLO_V8: ACTIVE<br/>> STATUS: SCANNING...`;
            document.getElementById('aiOverlay').style.color = "#22c55e";
            document.getElementById('aiOverlay').style.borderColor = "#22c55e";

            document.getElementById('detStatusUI').innerHTML = '<i data-lucide="shield-check" style="width: 16px;"></i> Đang giám sát an toàn';
            document.getElementById('detStatusUI').style.color = "#10b981";
            lucide.createIcons();
        }

        function selectAlert(id, title, date, time, img, isResolved) {
            currentAlertId = id;

            document.getElementById('detTitle').innerText = title;
            document.getElementById('detId').innerText = "ID Log Database: #" + id;
            document.getElementById('detTime').innerHTML = `<i data-lucide="clock" style="width: 16px; color: var(--accent);"></i> ${date} lúc ${time}`;

            document.getElementById('detImage').src = img;
            document.getElementById('detImage').style.objectFit = "contain"; // Ảnh bằng chứng thì thu nhỏ vừa vặn để xem hết

            document.getElementById('detBadge').style.display = "inline-flex";

            document.getElementById('aiOverlay').innerHTML = `> EVENT: LOITERING_DETECTED<br/>> SNAPSHOT RECORDED<br/>> REQUIRED ACTION!`;
            document.getElementById('aiOverlay').style.color = "#ef4444";
            document.getElementById('aiOverlay').style.borderColor = "#ef4444";

            let actionPanel = document.getElementById('actionPanel');
            let statusUI = document.getElementById('detStatusUI');

            if (isResolved) {
                statusUI.innerHTML = '<i data-lucide="check-circle" style="width: 16px;"></i> Đã giải quyết xong';
                statusUI.style.color = "#10b981";
                actionPanel.style.display = "none";
            } else {
                statusUI.innerHTML = '<i data-lucide="bell-ring" style="width: 16px; animation: pulse 1s infinite;"></i> Đang chờ xử lý';
                statusUI.style.color = "#ef4444";
                actionPanel.style.display = "block";
            }

            document.querySelectorAll('.alert-card').forEach(c => c.classList.remove('active'));
            if(event) event.currentTarget.classList.add('active');

            lucide.createIcons();
        }

        function updateStatus() {
            if (!currentAlertId) return;

            fetch(`/Admin/CanhBao/XuLySuCo`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `id=${currentAlertId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire("Thành công", data.message, "success");
                    loadAlerts();

                    document.getElementById('detStatusUI').innerHTML = '<i data-lucide="check-circle" style="width: 16px;"></i> Đã giải quyết xong';
                    document.getElementById('detStatusUI').style.color = "#10b981";
                    document.getElementById('actionPanel').style.display = "none";
                    lucide.createIcons();
                }
            });
        }

        loadAlerts();
        setInterval(loadAlerts, 2000);
    </script>
}