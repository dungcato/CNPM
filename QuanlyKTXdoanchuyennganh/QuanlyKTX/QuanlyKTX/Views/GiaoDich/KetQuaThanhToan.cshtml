@model QuanlyKTX.Models.VnPaymentResponseModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Kết quả giao dịch";
}

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 20px;">
    <div style="max-width: 500px; width: 100%; background: #ffffff; border-radius: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.08); overflow: hidden; position: relative;">

        @* Phần Header trạng thái *@
        <div style="padding: 40px 30px; text-align: center; background: @(Model.VnPayResponseCode == "00" ? "linear-gradient(to bottom, #f0fdf4, #ffffff)" : "linear-gradient(to bottom, #fff1f2, #ffffff)")">

            @if (Model.VnPayResponseCode == "00")
            {
                <div style="width: 80px; height: 80px; background: #10b981; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.3);">
                    <i data-lucide="check" style="width: 45px; height: 45px;"></i>
                </div>
                <h2 style="color: #064e3b; font-weight: 700; margin-bottom: 8px; font-size: 24px;">Thanh toán thành công</h2>
                <p style="color: #64748b; font-size: 14px;">Giao dịch của ông đã được hệ thống ghi nhận</p>
            }
            else
            {
                <div style="width: 80px; height: 80px; background: #ef4444; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; box-shadow: 0 8px 20px rgba(239, 68, 68, 0.3);">
                    <i data-lucide="x" style="width: 45px; height: 45px;"></i>
                </div>
                <h2 style="color: #7f1d1d; font-weight: 700; margin-bottom: 8px; font-size: 24px;">Thanh toán thất bại</h2>
                <p style="color: #64748b; font-size: 14px;">Rất tiếc, giao dịch không thể hoàn tất</p>
            }
        </div>

        @* Chi tiết biên lai *@
        <div style="padding: 0 35px 30px;">
            <div style="border: 1px dashed #e2e8f0; border-radius: 16px; padding: 25px; background: #f8fafc; position: relative;">
                @* Hiệu ứng răng cưa biên lai giả *@
                <div style="position: absolute; top: -10px; left: 0; right: 0; display: flex; justify-content: space-around;">
                    @for (int i = 0; i < 10; i++)
                    {
                        <div style="width:12px; height:12px; background:#ffffff; border-radius:50%; margin-top:2px;"></div>
                    }
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span style="color: #94a3b8; font-size: 13px; font-weight: 500;">Mã hóa đơn</span>
                    <span style="color: #1e293b; font-weight: 700; font-size: 14px;">#@Model.OrderId</span>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span style="color: #94a3b8; font-size: 13px; font-weight: 500;">Mã giao dịch VNPAY</span>
                    <span style="color: #1e293b; font-weight: 600; font-size: 14px;">@Model.TransactionId</span>
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                    <span style="color: #94a3b8; font-size: 13px; font-weight: 500;">Thời gian</span>
                    <span style="color: #1e293b; font-weight: 600; font-size: 14px;">@DateTime.Now.ToString("HH:mm dd/MM/yyyy")</span>
                </div>

                <div style="display: flex; justify-content: space-between; padding-top: 15px; border-top: 1px solid #e2e8f0;">
                    <span style="color: #1e293b; font-weight: 700; font-size: 15px;">Phương thức</span>
                    <span style="color: #1e293b; font-weight: 700; font-size: 15px;">Ví VNPAY / Ngân hàng</span>
                </div>
            </div>

            @* Nút điều hướng *@
            <div style="margin-top: 30px; display: flex; flex-direction: column; gap: 12px;">
                <a href="@Url.Action("HoaDon", "GiaoDich")"
                   style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; background: #1e3c72; color: white; border-radius: 12px; text-decoration: none; font-weight: 600; transition: all 0.2s;">
                    <i data-lucide="arrow-left" style="width: 18px;"></i> Quay lại danh sách hóa đơn
                </a>

                <button onclick="window.print()"
                        style="display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; background: #ffffff; color: #1e3c72; border: 1.5px solid #e2e8f0; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s;">
                    <i data-lucide="printer" style="width: 18px;"></i> In biên lai giao dịch
                </button>
            </div>
        </div>

        @* Phần Footer bo góc *@
        <div style="background: #f1f5f9; padding: 15px; text-align: center; font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px;">
            Hệ thống KTX Thông Minh - Đại học Vinh
        </div>
    </div>
</div>

<script>
    // Load icons
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>