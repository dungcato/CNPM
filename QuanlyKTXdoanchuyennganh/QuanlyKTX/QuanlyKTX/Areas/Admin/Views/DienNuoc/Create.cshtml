@model QuanlyKTX.Models.DienNuoc
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Nhập Chỉ số Điện Nước";
}

<style>
    .card-panel {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        padding: 30px;
        border: 1px solid #f1f5f9;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: block;
        }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        transition: 0.2s;
        box-sizing: border-box;
    }

        .form-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    .calc-result {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px dashed #cbd5e1;
        font-size: 0.95rem;
    }

        .calc-result:last-child {
            border-bottom: none;
            font-size: 1.15rem;
            font-weight: 800;
            color: #dc2626;
            margin-top: 10px;
            padding-top: 15px;
            border-top: 2px solid #fecaca;
        }
</style>

<div style="margin-bottom: 25px; display: flex; align-items: center; justify-content: space-between;">
    <div style="display: flex; align-items: center; gap: 15px;">
        <a href="/Admin/DienNuoc/Index" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 10px 15px; border-radius: 8px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <i data-lucide="arrow-left" style="width: 18px;"></i> Trở lại
        </a>
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0 0 3px 0;">Nhập Chỉ số Điện Nước Thủ công</h2>
            <p style="color: #64748b; font-size: 0.9rem; margin: 0;">Ghi nhận chỉ số đo công tơ điện nước từng phòng theo từng kỳ.</p>
        </div>
    </div>
</div>

<div class="card-panel">
    @if (TempData["Error"] != null)
    {
        <div style="padding: 15px; margin-bottom: 20px; background: #fee2e2; color: #dc2626; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <i data-lucide="alert-circle" style="width: 20px;"></i> @TempData["Error"]
        </div>
    }

    <form action="/Admin/DienNuoc/Create" method="post">
        @Html.AntiForgeryToken()

        <div style="background: #ecfdf5; padding: 18px 20px; border-radius: 12px; border: 1px dashed #34d399; margin-bottom: 25px; display: flex; align-items: center; gap: 15px; color: #065f46;">
            <i data-lucide="zap" style="width: 28px; height: 28px; flex-shrink: 0;"></i>
            <div>
                <h4 style="margin: 0 0 4px 0; font-size: 1rem; font-weight: 700;">Gợi ý chốt số tự động</h4>
                <p style="margin: 0; font-size: 0.88rem;">Nếu để trống ô <b>Điện Cũ</b> hoặc <b>Nước Cũ</b>, hệ thống sẽ tự động tìm chỉ số Mới của tháng trước để điền vào.</p>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">

            <!-- CỘT 1: THÔNG TIN PHÒNG & ĐƠN GIÁ -->
            <div style="background: #f8fafc; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0;">
                <h4 style="margin-top: 0; color: #4f46e5; font-weight: 800; border-bottom: 2px solid #e0e7ff; padding-bottom: 10px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="home" style="width: 20px;"></i> Thông Tin Phòng & Đơn Giá
                </h4>

                <div class="form-group">
                    <label>Phòng ghi nhận <span style="color:red">*</span></label>
                    <select name="PhongId" required class="form-input">
                        <option value="">-- Chọn phòng --</option>
                        @if (ViewBag.PhongList != null)
                        {
                            var pList = ViewBag.PhongList as List<QuanlyKTX.Models.Phong> ?? new List<QuanlyKTX.Models.Phong>();
                            foreach (var p in pList)
                            {
                                <option value="@p.PhongId">Phòng @p.PhongId (Tòa @(p.ToaNhaId ?? "---"))</option>
                            }
                        }
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group">
                        <label>Kỳ chốt (Tháng) <span style="color:red">*</span></label>
                        <input type="number" name="Thang" min="1" max="12" value="@(ViewBag.ThangHienTai ?? DateTime.Now.Month)" required class="form-input" />
                    </div>
                    <div class="form-group">
                        <label>Năm <span style="color:red">*</span></label>
                        <input type="number" name="Nam" min="2020" max="2099" value="@(ViewBag.NamHienTai ?? DateTime.Now.Year)" required class="form-input" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group">
                        <label>Đơn giá Điện (VNĐ/kWh)</label>
                        <input type="number" name="DonGiaDien" id="donGiaDien" value="3500" class="form-input auto-calc" />
                    </div>
                    <div class="form-group">
                        <label>Đơn giá Nước (VNĐ/m³)</label>
                        <input type="number" name="DonGiaNuoc" id="donGiaNuoc" value="15000" class="form-input auto-calc" />
                    </div>
                </div>
            </div>

            <!-- CỘT 2: CHỈ SỐ TIÊU THỤ & DỰ KIẾN TIỀN -->
            <div style="background: #fff; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                <h4 style="margin-top: 0; color: #f59e0b; font-weight: 800; border-bottom: 2px solid #fef3c7; padding-bottom: 10px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="gauge" style="width: 20px;"></i> Chỉ Số Tiêu Thụ
                </h4>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group">
                        <label>Điện Cũ</label>
                        <input type="number" name="DienCu" id="dienCu" class="form-input auto-calc" placeholder="Tự động lấy số cũ..." />
                    </div>
                    <div class="form-group">
                        <label style="color: #b91c1c;">Điện Mới <span style="color:red">*</span></label>
                        <input type="number" name="DienMoi" id="dienMoi" required class="form-input auto-calc" style="border-color: #fca5a5; background: #fef2f2;" placeholder="Nhập chỉ số mới..." />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 10px;">
                    <div class="form-group">
                        <label>Nước Cũ</label>
                        <input type="number" name="NuocCu" id="nuocCu" class="form-input auto-calc" placeholder="Tự động lấy số cũ..." />
                    </div>
                    <div class="form-group">
                        <label style="color: #0369a1;">Nước Mới <span style="color:red">*</span></label>
                        <input type="number" name="NuocMoi" id="nuocMoi" required class="form-input auto-calc" style="border-color: #7dd3fc; background: #f0f9ff;" placeholder="Nhập chỉ số mới..." />
                    </div>
                </div>

                <!-- BẢNG TÍNH TIỀN HÓA ĐƠN TRỰC TIẾP -->
                <h4 style="margin-top: 25px; color: #10b981; font-weight: 800; border-bottom: 2px solid #dcfce7; padding-bottom: 8px; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="calculator" style="width: 18px;"></i> Tạm tính Tiền Điện Nước
                </h4>
                <div style="background: #f8fafc; padding: 15px; border-radius: 8px; border: 1px dashed #cbd5e1;">
                    <div class="calc-result">
                        <span>Tiêu thụ Điện (<span id="ttDien" style="font-weight: 700; color: #2563eb;">0</span>)</span>
                        <span id="tienDien" style="font-weight: 700; color: #475569;">0 đ</span>
                    </div>
                    <div class="calc-result">
                        <span>Tiêu thụ Nước (<span id="ttNuoc" style="font-weight: 700; color: #0284c7;">0</span>)</span>
                        <span id="tienNuoc" style="font-weight: 700; color: #475569;">0 đ</span>
                    </div>
                    <div class="calc-result">
                        <span>TỔNG TIỀN DỰ KIẾN</span>
                        <span id="tongTien">0 đ</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- KHỐI CÁC NÚT BẤM LƯU -->
        <div style="display: flex; justify-content: flex-end; align-items: center; gap: 15px; border-top: 1px solid #f1f5f9; padding-top: 25px; margin-top: 25px;">
            <a href="/Admin/DienNuoc/Index" style="background: #f1f5f9; color: #64748b; padding: 12px 25px; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i data-lucide="x" style="width: 18px;"></i> Hủy
            </a>

            <!-- NÚT 1: LƯU CHỈ SỐ (CHƯA XUẤT HÓA ĐƠN) -->
            <button type="submit" name="taoHoaDon" value="false" style="background: #3b82f6; color: white; padding: 12px 28px; font-size: 1rem; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(59, 130, 246, 0.25);">
                <i data-lucide="save" style="width: 18px;"></i> Lưu Chỉ Số
            </button>

            <!-- NÚT 2: LƯU VÀ PHÁT HÀNH HÓA ĐƠN NGAY -->
            <button type="submit" name="taoHoaDon" value="true" style="background: #10b981; color: white; padding: 12px 28px; font-size: 1rem; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.25);">
                <i data-lucide="send" style="width: 18px;"></i> Lưu & Tạo Hóa Đơn Ngay
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        if (typeof lucide !== 'undefined') { lucide.createIcons(); }

        document.addEventListener('DOMContentLoaded', function () {
            const dienCu = document.getElementById('dienCu');
            const dienMoi = document.getElementById('dienMoi');
            const nuocCu = document.getElementById('nuocCu');
            const nuocMoi = document.getElementById('nuocMoi');
            const donGiaDien = document.getElementById('donGiaDien');
            const donGiaNuoc = document.getElementById('donGiaNuoc');

            const ttDien = document.getElementById('ttDien');
            const ttNuoc = document.getElementById('ttNuoc');
            const tienDien = document.getElementById('tienDien');
            const tienNuoc = document.getElementById('tienNuoc');
            const tongTien = document.getElementById('tongTien');

            const formatVND = num => new Intl.NumberFormat('vi-VN').format(num) + ' đ';

            function calculateInvoice() {
                let dc = parseFloat(dienCu.value) || 0;
                let dm = parseFloat(dienMoi.value) || 0;
                let nc = parseFloat(nuocCu.value) || 0;
                let nm = parseFloat(nuocMoi.value) || 0;
                let gd = parseFloat(donGiaDien.value) || 0;
                let gn = parseFloat(donGiaNuoc.value) || 0;

                let td = Math.max(0, dm - dc);
                let tn = Math.max(0, nm - nc);

                let sumDien = td * gd;
                let sumNuoc = tn * gn;

                ttDien.innerText = td + ' kWh';
                ttNuoc.innerText = tn + ' m³';
                tienDien.innerText = formatVND(sumDien);
                tienNuoc.innerText = formatVND(sumNuoc);
                tongTien.innerText = formatVND(sumDien + sumNuoc);
            }

            document.querySelectorAll('.auto-calc').forEach(el => {
                el.addEventListener('input', calculateInvoice);
            });

            calculateInvoice();
        });
    </script>
}
