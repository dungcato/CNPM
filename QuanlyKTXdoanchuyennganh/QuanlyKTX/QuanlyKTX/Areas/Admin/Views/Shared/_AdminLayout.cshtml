<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BQL KTX Đại học Vinh</title>
    <link rel="stylesheet" href="~/css/admin-style.css" asp-append-version="true" />
    <style>
        /* CSS cho Dropdown Profile chuyên nghiệp */
        .profile-dropdown {
            position: relative;
            display: inline-block;
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 5px 10px;
            border-radius: 8px;
            transition: 0.3s;
        }

            .admin-profile:hover {
                background: rgba(255,255,255,0.1);
            }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 110%;
            background: #ffffff;
            min-width: 200px;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            z-index: 9999;
            border: 1px solid #e2e8f0;
        }

        .profile-dropdown:hover .dropdown-content {
            display: block;
        }

        .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            color: #1e293b;
            text-decoration: none;
            font-size: 14px;
            transition: 0.2s;
        }

            .dropdown-item:hover {
                background: #f1f5f9;
                color: #3b82f6;
            }

        .logout-item {
            color: #ef4444 !important;
            border-top: 1px solid #e2e8f0;
        }

            .logout-item:hover {
                background: #fff1f2;
            }
    </style>
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>

    <div class="app-admin-container">

        <!-- ================= SIDEBAR TRÁI ĐẦY ĐỦ ================= -->
        <aside class="sidebar-admin">
            <div class="sidebar-brand">
                <h2>BQL KTX ĐẠI HỌC<br />VINH</h2>
                <p>Hệ thống Quản lý</p>
            </div>
            <nav class="sidebar-nav">
                <!-- TỔNG QUAN -->
                <div class="nav-group-title">TỔNG QUAN</div>
                <ul class="nav-item">
                    <li>
                        <a href="/Admin/Home/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                            <i data-lucide="layout-dashboard"></i> Tổng quan
                        </a>
                    </li>
                </ul>

                <!-- QUẢN LÝ NGHIỆP VỤ -->
                <div class="nav-group-title">QUẢN LÝ NGHIỆP VỤ</div>
                <ul class="nav-item">
                    <li><a href="/Admin/SinhVien/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "SinhVien" ? "active" : "")"><i data-lucide="users"></i> Quản lý Sinh viên</a></li>
                    <li><a href="/Admin/HopDong/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HopDong" ? "active" : "")"><i data-lucide="file-text"></i> Quản lý Hợp đồng</a></li>

                    <li><a href="/Admin/HoaDon/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "HoaDon" ? "active" : "")"><i data-lucide="dollar-sign"></i> Quản lý Hóa đơn</a></li>
                    <li><a href="/Admin/CoSoVatChat/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CoSoVatChat" ? "active" : "")"><i data-lucide="database"></i> Quản lý Cơ sở vật chất</a></li>

                    <li><a href="/Admin/Toa/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Toa" ? "active" : "")"><i data-lucide="layout"></i> Quản lý Tòa</a></li>
                    <li><a href="/Admin/Phong/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Phong" ? "active" : "")"><i data-lucide="layout"></i> Quản lý Phòng</a></li>
                    <li><a href="/Admin/ThongBao/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ThongBao" ? "active" : "")"><i data-lucide="send"></i> Gửi thông báo</a></li>
                    <li><a href="/Admin/PhanAnh/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "PhanAnh" ? "active" : "")"><i data-lucide="wrench"></i> Xử lý Phản ánh</a></li>
                    <li><a href="/Admin/DienNuoc/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DienNuoc" ? "active" : "")"><i data-lucide="droplet"></i> Ghi nhận Điện nước</a></li>
                </ul>

                <!-- QUẢN LÝ AN NINH -->
                <div class="nav-group-title">QUẢN LÝ AN NINH</div>
                <ul class="nav-item">
                    <li><a href="/Admin/Camera/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Camera" ? "active" : "")"><i data-lucide="camera"></i> Giám sát Camera AI</a></li>
                    <li><a href="/Admin/Khach/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Khach" ? "active" : "")"><i data-lucide="user-plus"></i> Đăng ký khách</a></li>
                    <li><a href="/Admin/CanhBao/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "CanhBao" ? "active" : "")"><i data-lucide="alert-triangle"></i> Cảnh báo & Sự cố</a></li>
                </ul>

                <!-- HỆ THỐNG -->
                <div class="nav-group-title">HỆ THỐNG</div>
                <ul class="nav-item">
                    <li><a href="/Admin/TaiKhoan/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "TaiKhoan" ? "active" : "")"><i data-lucide="settings"></i> Tài khoản & Phân quyền</a></li>
                </ul>
            </nav>
        </aside>

        <!-- ================= KHU VỰC CHÍNH ================= -->
        <main class="main-admin-wrapper">
            <header class="header-admin">
                <div class="header-left">
                    <img src="~/Admin/logo/Picture1.png" alt="Logo" class="header-logo" onerror="this.src='https://placehold.co/50x50?text=VU'" />
                    <div class="header-welcome">
                        <h2>Xin chào @(User.Identity?.Name ?? "Quản trị viên")!</h2>
                        <p>Hệ thống KTX Đại học Vinh</p>
                    </div>
                </div>

                <div class="header-right">
                    <div class="search-box">
                        <i data-lucide="search" style="width: 16px;"></i>
                        <input type="text" placeholder="Tìm kiếm nhanh..." />
                    </div>

                    <!-- PROFILE & LOGOUT -->
                    <div class="profile-dropdown">
                        <div class="admin-profile">
                            <div class="admin-info">
                                <p>@(User.Identity?.Name ?? "Admin")</p>
                                <span style="font-size: 11px; color: #94a3b8; font-weight: bold;">
                                    @(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Ban quản lý")
                                </span>
                            </div>
                            <img src="https://ui-avatars.com/api/?name=@(User.Identity?.Name)&background=1e293b&color=fff" class="admin-avatar" />
                        </div>
                        <div class="dropdown-content">
                            <a href="/Admin/TaiKhoan/Profile" class="dropdown-item">
                                <i data-lucide="user" style="width: 16px;"></i> Hồ sơ cá nhân
                            </a>
                            <a href="/Account/Logout" class="dropdown-item logout-item">
                                <i data-lucide="log-out" style="width: 16px;"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-admin-scroll">
                <!-- HIỂN THỊ THÔNG BÁO LỖI/THÀNH CÔNG -->
                @if (
                    ViewContext.RouteData.Values["Controller"]?.ToString() != "Toa" && 
                    ViewContext.RouteData.Values["Controller"]?.ToString() != "Phong" && 
                    ViewContext.RouteData.Values["Controller"]?.ToString() != "SinhVien" && 
                    TempData["Error"] != null)
                {
                    <div style="background: #fee2e2; color: #b91c1c; padding: 15px; margin: 20px; border-radius: 8px; border: 1px solid #fecaca;">
                        <i data-lucide="alert-circle" style="vertical-align: middle; width: 18px;"></i> @TempData["Error"]
                    </div>
                }

                <div class="admin-content-area">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script>lucide.createIcons();</script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>