@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập - KTX Thông Minh</title>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            min-height: 100vh;
            background: #1565c0;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

            body::before {
                content: '';
                position: absolute;
                width: 600px;
                height: 600px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                top: -200px;
                left: -150px;
                pointer-events: none;
            }

            body::after {
                content: '';
                position: absolute;
                width: 400px;
                height: 400px;
                border-radius: 50%;
                background: rgba(255,255,255,0.05);
                bottom: -100px;
                right: -100px;
                pointer-events: none;
            }

        .login-card {
            background: #1976d2;
            border-radius: 16px;
            padding: 44px 48px 48px;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 24px 64px rgba(0,0,0,0.3);
            position: relative;
            z-index: 1;
            animation: fadeUp 0.5s ease both;
        }

       
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 36px;
        }

        .logo-placeholder {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            border: 2px dashed rgba(255,255,255,0.4);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .logo-placeholder img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        .school-info h1 {
            font-size: 20px;
            font-weight: 800;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .school-info p {
            font-size: 11px;
            font-weight: 600;
            color: rgba(255,255,255,0.75);
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .field-group {
            display: flex;
            align-items: center;
            margin-bottom: 16px;
            gap: 16px;
        }

            .field-group label {
                font-size: 14px;
                font-weight: 600;
                color: #fff;
                white-space: nowrap;
                min-width: 110px;
                text-align: right;
            }

            .field-group input[type="text"],
            .field-group input[type="password"] {
                flex: 1;
                padding: 12px 16px;
                border-radius: 8px;
                border: none;
                background: #fff;
                font-family: inherit;
                font-size: 14px;
                color: #1a1a1a;
                outline: none;
                transition: box-shadow 0.2s;
            }

            .field-group input:focus {
                box-shadow: 0 0 0 3px rgba(255,255,255,0.4);
            }

        .extra-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-left: 126px;
            margin-bottom: 24px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: rgba(255,255,255,0.85);
            cursor: pointer;
        }

            .remember input[type="checkbox"] {
                accent-color: #fff;
                width: 14px;
                height: 14px;
            }

        .forgot {
            font-size: 12px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
        }

            .forgot:hover {
                color: #fff;
                text-decoration: underline;
            }

        .alert-error {
            background: rgba(255,80,80,0.2);
            border: 1px solid rgba(255,120,120,0.5);
            border-radius: 8px;
            color: #ffcdd2;
            font-size: 13px;
            padding: 10px 14px;
            margin-bottom: 16px;
            text-align: center;
        }

        .btn-login {
            display: block;
            width: 100%;
            padding: 14px;
            background: #0d47a1;
            color: #fff;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
            box-shadow: 0 4px 16px rgba(0,0,0,0.25);
        }

            .btn-login:hover {
                background: #083378;
            }

            .btn-login:active {
                transform: scale(0.98);
            }
    </style>
</head>
<body>
    <div class="login-card">

        <div class="card-header">
            <div class="logo-placeholder">
                <img src="~/Admin/logo/Picture1.png" alt="Logo" />
            </div>
            <div class="school-info">
                <h1>Trường Đại Học Vinh</h1>
                <p>Cổng thông tin Ký túc xá sinh viên - USmart</p>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">@ViewBag.Error</div>
        }

        <form method="post" action="/Account/Login">
            @Html.AntiForgeryToken()

            <div class="field-group">
                <label for="username">Tên Đăng Nhập:</label>
                <input type="text" id="username" name="username"
                       placeholder="Nhập tên đăng nhập" required />
            </div>

            <div class="field-group">
                <label for="password">Mật Khẩu:</label>
                <input type="password" id="password" name="password"
                       placeholder="••••••••" required />
            </div>

            <div class="extra-row">
                <label class="remember">
                    <input type="checkbox" name="rememberMe" />
                    ghi nhớ mật khẩu
                </label>
                <a href="#" class="forgot">quên mật khẩu ?</a>
            </div>

            <button type="submit" class="btn-login">Đăng Nhập</button>
        </form>
    </div>
</body>
</html>