@model QuanlyKTX.Models.ToaNha
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Toà Mới";
}

<style>
    .card-panel {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        padding: 30px;
        border: 1px solid #f1f5f9;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            font-weight: 600;
            color: #475569;
            font-size: 0.9rem;
            margin-bottom: 8px;
            display: block;
        }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        transition: 0.2s;
    }

        .form-input:focus {
            outline: none;
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
        }
</style>

<div style="margin-bottom: 25px; display: flex; align-items: center; gap: 15px;">
    <a href="/Admin/Toa/Index" style="background: white; border: 1px solid #cbd5e1; color: #64748b; padding: 10px 15px; border-radius: 8px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="arrow-left" style="width: 18px;"></i> Trở lại
    </a>
    <h2 style="font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0;">Thiết Lập Tòa Mới</h2>
</div>

<div class="card-panel">
    @if (TempData["Error"] != null)
    {
        <div style="padding: 15px; margin-bottom: 20px; background: #fee2e2; color: #dc2626; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
            <i data-lucide="alert-circle" style="width: 20px;"></i> @TempData["Error"]
        </div>
    }

    <form action="/Admin/Toa/Create" method="post">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">

            <div style="background: #f8fafc; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0;">
                <div class="form-group">
                    <label>Mã Tòa (Khóa chính) <span style="color:red">*</span></label>
                    <input type="text" name="ToaNhaId" required class="form-input" placeholder="Ví dụ: A1" />
                    <small style="color: #94a3b8; margin-top: 5px; display: block;">Mã tòa phải là duy nhất.</small>
                </div>

                <div class="form-group">
                    <label>Tên tòa hiển thị</label>
                    <input type="text" name="TenToa" class="form-input" placeholder="Ví dụ: Tòa A1" />
                </div>
            </div>

            <div style="background: #fff; padding: 25px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.02);">
                <div class="form-group">
                    <label>Số tầng<span style="color:red"></span></label>
                    <input type="text" name="SoTang" class="form-input" placeholder="" />
                </div>

                <div class="form-group">
                    <label>Loại khu<span style="color:red"></span></label>
                    <input type="text" name="LoaiKhu" class="form-input" placeholder="" />
                </div>

                <div class="form-group">
                    <label>Trưởng nhà<span style="color:red"></span></label>
                    <input type="text" name="TruongNha" class="form-input" placeholder="" />
                </div>
            </div>
        </div>

        <div style="text-align: right; border-top: 1px solid #f1f5f9; padding-top: 25px; margin-top: 20px;">
            <button type="submit" style="background: #10b981; color: white; padding: 12px 40px; font-size: 1.05rem; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);">
                <i data-lucide="save"></i> Khởi Tạo Tòa Mới
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>if (typeof lucide !== 'undefined') { lucide.createIcons(); }</script>
}