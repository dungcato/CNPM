@model IEnumerable<QuanlyKTX.Models.ToaNha>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Tòa";
}

<style>
    /* BỐ CỤC CHUNG */
    .page-header {
        margin-bottom: 25px;
    }

    .page-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0 0 5px 0;
    }

    .page-subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin: 0;
    }

    /* DASHBOARD CARDS */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-item {
        background: white;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        border: 1px solid #f1f5f9;
        transition: 0.2s;
    }

        .stat-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        }

    .stat-icon-box {
        width: 55px;
        height: 55px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        flex-shrink: 0;
    }

    .stat-details h4 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 900;
        color: #1e293b;
        line-height: 1;
        margin-bottom: 5px;
    }

    .stat-details p {
        margin: 0;
        font-size: 0.85rem;
        color: #64748b;
        font-weight: 600;
    }

    /* KHỐI FORM & BẢNG */
    .info-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.02);
        padding: 25px;
        margin-bottom: 25px;
        border: 1px solid #f1f5f9;
    }

    .info-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

    .info-header-title {
        font-size: 1.1rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* INPUT FORMS */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        align-items: end;
    }

    .form-group-admin label {
        font-weight: 600;
        color: #475569;
        font-size: 0.85rem;
        margin-bottom: 8px;
        display: block;
    }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper i {
            position: absolute;
            left: 12px;
            top: 11px;
            color: #94a3b8;
            width: 18px;
        }

        .input-wrapper input, .input-wrapper select {
            width: 100%;
            padding: 10px 10px 10px 40px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-family: inherit;
            font-size: 0.95rem;
        }

    .btn-add-new {
        background: #4f46e5;
        color: white;
        border: none;
        height: 43px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: 0.2s;
    }

        .btn-add-new:hover {
            background: #4338ca;
        }

    /* BẢNG DỮ LIỆU */
    .table-container {
        overflow-x: auto;
        margin-top: 15px;
    }

    .user-table {
        width: 100%;
        border-collapse: collapse;
    }

        .user-table th {
            background: #f8fafc;
            color: #64748b;
            font-weight: 600;
            padding: 15px;
            text-align: left;
            font-size: 0.8rem;
            text-transform: uppercase;
            border-bottom: 2px solid #e2e8f0;
        }

        .user-table td {
            padding: 15px;
            border-bottom: 1px solid #f8fafc;
            vertical-align: middle;
        }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar-small {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        object-fit: cover;
    }

    .user-name-box .name {
        font-weight: 800;
        color: #1e293b;
        font-size: 0.95rem;
    }

    .user-name-box .email {
        font-size: 0.8rem;
        color: #64748b;
    }

    /* BADGE ROLE */
    .role-badge {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .role-admin {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .role-manager {
        background: #e0e7ff;
        color: #4f46e5;
        border: 1px solid #c7d2fe;
    }

    .role-guard {
        background: #ffedd5;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .role-default {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* NÚT BẬT TẮT SWITCH (BAN/UNBAN) */
    .switch {
        position: relative;
        display: inline-block;
        width: 46px;
        height: 24px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #cbd5e1;
        transition: .3s;
        border-radius: 24px;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }

    input:checked + .slider {
        background-color: #10b981;
    }

        input:checked + .slider:before {
            transform: translateX(22px);
        }

    /* NÚT TÁC VỤ */
    .btn-act {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        cursor: pointer;
        transition: 0.2s;
        margin-right: 5px;
    }

    .btn-reset {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-reset:hover {
            background: #fde68a;
        }

    .btn-del {
        background: #fef2f2;
        color: #ef4444;
    }

        .btn-del:hover {
            background: #fecaca;
        }
</style>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
    <div>
        <h2 style="font-size: 1.5rem; font-weight: 800; color: #1e293b; margin: 0; margin-bottom: 5px;">Quản Lý Tòa nhà</h2>
    </div>
    <!-- LINK SANG TRANG CREATE MỚI -->
    <a href="/Admin/Toa/Create" style="background: #10b981; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);">
        <i data-lucide="plus-circle" style="width: 18px;"></i> Thêm tòa mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding: 15px; margin-bottom: 20px; background: #dcfce7; color: #16a34a; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="check-circle" style="width: 20px;"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="padding: 15px; margin-bottom: 20px; background: #fee2e2; color: #dc2626; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
        <i data-lucide="alert-circle" style="width: 20px;"></i> @TempData["Error"]
    </div>
}

<div class="info-card">
    <div class="info-header" style="margin-bottom: 15px; border-bottom: none; padding-bottom: 0;">
        <div class="info-header-title" style="color: #1e293b;"><i data-lucide="list" style="width: 20px;"></i> Danh sách tòa</div>
    </div>

    <div class="table-container">
        <table class="user-table">
            <thead>
                <tr>
                    <th>Mã tòa</th>
                    <th>Tên tòa</th>
                    <th>Số tầng</th>
                    <th>Loại khu</th>
                    <th>Trưởng nhà</th>
                    <th style="text-align: center;">Tác vụ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ToaNhaId</td>
                        <td>@item.TenToa</td>
                        <td>@item.SoTang</td>
                        <td>@item.LoaiKhu</td>
                        <td>@item.TruongNha</td>

                        <td style="text-align: center;">
                            <div style="display: flex; gap: 5px; justify-content: center;">
                                <form action="/Admin/Toa/Edit/@item.ToaNhaId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-act btn-reset" title="Chỉnh sửa"><i data-lucide="edit-3" style="width: 16px;"></i></button>
                                </form>

                                <form action="/Admin/Toa/Delete/@item.ToaNhaId" method="post" onsubmit="return confirm('XÓA VĨNH VIỄN tòa @item.TenToa?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-act btn-del" title="Xóa tòa"><i data-lucide="trash-2" style="width: 16px;"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>